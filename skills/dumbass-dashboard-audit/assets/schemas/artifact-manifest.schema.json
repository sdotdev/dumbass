{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumbass.dev/protocol/1.0.0/artifact-manifest.schema.json",
  "title": "Dumbass artifact-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "manifest",
              "capabilities",
              "baseline",
              "event-log",
              "frame",
              "outcome",
              "findings",
              "coverage",
              "report",
              "remediation",
              "verification",
              "other"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "artifacts"
  ],
  "additionalProperties": false
}
