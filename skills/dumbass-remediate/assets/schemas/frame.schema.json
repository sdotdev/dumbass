{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumbass.dev/protocol/1.0.0/frame.schema.json",
  "title": "Dumbass frame",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "captured_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "path": {
      "$ref": "common.schema.json#/$defs/relative_path"
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "viewport": {
      "$ref": "common.schema.json#/$defs/viewport"
    },
    "scroll": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "coordinate_space": {
      "type": "string",
      "enum": [
        "css-viewport",
        "screenshot-pixels"
      ]
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "reason",
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "session_id",
    "frame_id",
    "captured_at",
    "path",
    "sha256",
    "width",
    "height",
    "viewport",
    "scroll",
    "coordinate_space",
    "redactions"
  ],
  "additionalProperties": false
}
