{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumbass.dev/protocol/1.0.0/verification.schema.json",
  "title": "Dumbass verification",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "baseline_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "patch_reference": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "partial",
              "unresolved",
              "unverified"
            ]
          },
          "task_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "personas_covered": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/persona" },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence"
            }
          },
          "engineering_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "status",
          "task_id",
          "personas_covered",
          "evidence",
          "engineering_checks",
          "notes"
        ],
        "additionalProperties": false,
        "allOf": [{
          "if": {
            "properties": { "status": { "enum": ["resolved", "partial"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
                "evidence": { "type": "array", "minItems": 1 },
                "personas_covered": { "type": "array", "minItems": 1 }
            }
          }
        }]
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "baseline_run_id",
    "patch_reference",
    "results",
    "regressions",
    "limitations"
  ],
  "additionalProperties": false
}
