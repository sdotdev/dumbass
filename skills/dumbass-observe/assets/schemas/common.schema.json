{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumbass.dev/protocol/1.0.0/common.schema.json",
  "title": "Dumbass shared types",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "persona": {
      "type": "string",
      "enum": [
        "novice",
        "expert"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "device_scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "device_scale_factor"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "frame_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id",
        "frame_id",
        "description"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "start_url": {
          "type": "string",
          "format": "uri"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "task_id",
        "title",
        "start_url",
        "success_criteria"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "click",
            "tap",
            "scroll",
            "swipe",
            "type",
            "keypress",
            "wait"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "to_x": {
          "type": "number"
        },
        "to_y": {
          "type": "number"
        },
        "delta_x": {
          "type": "number"
        },
        "delta_y": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "classification": {
          "type": "string",
          "enum": [
            "navigation",
            "local",
            "mutation"
          ]
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        }
      },
      "required": [
        "type",
        "classification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "click",
                  "tap"
                ]
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scroll"
              }
            }
          },
          "then": {
            "required": [
              "delta_y"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "swipe"
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y",
              "to_x",
              "to_y",
              "duration_ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "type"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "keypress"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            }
          },
          "then": {
            "required": [
              "duration_ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "mutation"
              }
            }
          },
          "then": {
            "required": [
              "authorization_id"
            ]
          }
        }
      ]
    }
  }
}
