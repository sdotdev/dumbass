{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumbass.dev/protocol/1.0.0/event.schema.json",
  "title": "Dumbass event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "type": {
      "type": "string",
      "enum": [
        "observation",
        "action",
        "result",
        "stop",
        "error"
      ]
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "next_frame_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "action": {
      "$ref": "common.schema.json#/$defs/action"
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "blocked",
        "error",
        "inconclusive"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "CAPABILITY_MISSING",
        "TARGET_OUT_OF_SCOPE",
        "ACTION_REQUIRES_AUTHORIZATION",
        "STALE_FRAME",
        "TIMEOUT",
        "BASELINE_RESET_FAILED",
        "BUDGET_EXHAUSTED",
        "INVALID_ARTIFACT"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "session_id",
    "event_id",
    "sequence",
    "timestamp",
    "type",
    "status"
  ],
  "additionalProperties": false
}
